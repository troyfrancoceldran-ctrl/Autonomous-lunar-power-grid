__pycache__/
*.py[cod]
# .venv is a SYMLINK to ~/.venvs/lunar, deliberately outside iCloud Drive.
# Desktop is iCloud-synced, and with the venv living there macOS evicted 8120
# of its 8167 files to the cloud — `import matplotlib` cost 230 s cold against
# 0.22 s warm, and the suite took 11m44s instead of 2.5s. No trailing slash:
# that pattern matches a directory and would miss the symlink.
.venv
.venv.icloud-old
venv/
.DS_Store
data/output_logs/*.csv
data/output_logs/*.parquet
.pytest_cache/
*.egg-info/
data/history_*.csv
data/history_*.json
data/figures/

# docs/figures/ IS committed: the README renders results, so a reader
# should not have to run the simulation to see what it found.

# PNG previews written beside the formula PDF are a build artifact of
# docs/make_protection_formulas.py, used to eyeball the PDF before shipping it.
docs/_formulas_preview_*.png

# CMake build tree for the estimator — a build artifact, not source.
estimator/build/
